# OutSystems LifeTime MCP Server — environment variables
# Copy to `.env` and fill in real values. `.env` is gitignored.

# ── Required ─────────────────────────────────────────────────────────────────
# LifeTime REST API v2 base URL
LIFETIME_BASE_URL=https://your-lifetime.example.com/lifetimeapi/rest/v2
# Service Account Bearer token
# (LifeTime → User Management → Service Accounts)
LIFETIME_API_TOKEN=your-service-account-token

# ── HTTP mode (optional — only needed for Claude.ai / iOS Safari) ─────────────
# Set HTTP_PORT to run the Streamable HTTP transport instead of stdio.
HTTP_PORT=3456
# Bearer token clients must send. Leave unset to disable auth (NOT recommended).
HTTP_BEARER_TOKEN=change-me-to-something-secret
